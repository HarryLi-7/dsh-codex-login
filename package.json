      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  }
